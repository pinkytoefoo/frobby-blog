---
interface Props {
    user?: string;
    host?: string;
    path?: string;
}

const {
    user = 'root',
    host = 'archiso',
    path = '~',
} = Astro.props;
---

<div class="terminal">
    <div class="terminal-header">
        <span class="dot red"></span>
        <span class="dot yellow"></span>
        <span class="dot green"></span>
    </div>

    <div class="terminal-body">
        <span class="prompt">
            <span class="user">{user}</span><span class="at">@</span><span class="host">{host}</span>
            <span class="path">{path}</span>
            <span class="symbol">{user === 'root' ? '#' : '$'}</span>
        </span>

        <code><slot /></code>
    </div>
</div>

<style>
    .terminal {
        overflow: hidden;

        margin: 1.5rem 0;
        border: 1px solid var(--color-border);
        border-radius: 8px;

        background: var(--color-code-background, #111);
        box-shadow: 0 8px 30px rgb(0 0 0 / 12%);
    }

    .terminal-header {
        display: flex;
        align-items: center;
        gap: 0.45rem;

        height: 2rem;
        padding: 0 0.75rem;

        border-bottom: 1px solid var(--color-border);

        background: rgb(255 255 255 / 0.025);
    }

    .dot {
        width: 0.6rem;
        height: 0.6rem;
        border-radius: 50%;
    }

    .red {
        background: #ff5f57;
    }

    .yellow {
        background: #febc2e;
    }

    .green {
        background: #28c840;
    }

    .terminal-body {
        overflow-x: auto;

        padding: 1rem 1.25rem;

        font-family: var(--font-mono);
        font-size: 0.9rem;
        line-height: 1.6;

        white-space: nowrap;
    }

    .prompt {
        user-select: none;
    }

    .user {
        color: #7aa2f7;
    }

    .at {
        color: var(--color-muted);
    }

    .host {
        color: #9ece6a;
    }

    .path {
        margin-left: 0.5rem;
        color: #bb9af7;
    }

    .symbol {
        margin-left: 0.5rem;
        color: #f7768e;
    }

    code {
        margin-left: 0.5rem;
        color: var(--color-text);
    }
</style>